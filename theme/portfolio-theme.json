{
  "name": "Online Retail Portfolio",
  "dataColors": ["#1F4E79", "#E36C2D", "#5B9A8B", "#C9A227", "#7F6A93", "#4F81BD", "#9AA5B1", "#B04A5A"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F4E79",
  "good": "#2E7D32",
  "neutral": "#9AA5B1",
  "bad": "#C62828",
  "maximum": "#1F4E79",
  "center": "#9DB7D5",
  "minimum": "#F2F6FA",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52606D" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F7FA" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }]
      }
    }
  }
}
